#!/bin/bash
# Interactive setup: detect claude, pick provider (+ verify key), pick policy, patch + smoke test.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CC_HOME="${CC_TURN_EXT_HOME:-$HOME/.cc-turn-ext}"; mkdir -p "$CC_HOME/handlers" "$CC_HOME/cache"
CFG="$CC_HOME/config.json"
ask(){ local p="$1" d="${2:-}"; local a; read -r -p "$p " a </dev/tty || true; echo "${a:-$d}"; }

echo "── cc-turn-ext setup ──"
echo
echo "1) Claude Code"
REAL="$(readlink -f "$(command -v claude)" 2>/dev/null || true)"
[[ -z "$REAL" ]] && { echo "   claude not found in PATH. install Claude Code first."; exit 1; }
echo "   found: $(basename "$REAL")  $(file "$REAL" | grep -o 'arm64\|x86_64' | head -1)"

echo
echo "2) Provider  [1] Gemini  [2] OpenAI  [3] OpenRouter  [4] Local  [5] custom"
case "$(ask 'choose (1):' 1)" in
  2) BASE="https://api.openai.com/v1"; MODEL="$(ask 'model (gpt-4o-mini):' gpt-4o-mini)"; ENVV="OPENAI_API_KEY";;
  3) BASE="https://openrouter.ai/api/v1"; MODEL="$(ask 'model (google/gemini-2.5-flash):' google/gemini-2.5-flash)"; ENVV="OPENROUTER_API_KEY";;
  4) BASE="$(ask 'baseUrl (http://127.0.0.1:11434/v1):' http://127.0.0.1:11434/v1)"; MODEL="$(ask 'model (llama3.1):' llama3.1)"; ENVV="";;
  5) BASE="$(ask 'baseUrl:')"; MODEL="$(ask 'model:')"; ENVV="$(ask 'apiKey env var name (blank if none):')";;
  *) BASE="https://generativelanguage.googleapis.com/v1beta/openai"; MODEL="$(ask 'model (gemini-2.5-flash):' gemini-2.5-flash)"; ENVV="GEMINI_API_KEY";;
esac
KEY="$(ask 'API key (blank = use env/keychain):')"

# write config
node --input-type=module -e "
import {readFileSync,writeFileSync} from 'node:fs';
let c={}; try{c=JSON.parse(readFileSync('$CFG','utf8'));}catch{}
c.provider={ baseUrl:'$BASE', model:'$MODEL', apiKey:'$KEY', apiKeyEnv:'$ENVV', apiKeyKeychain:(c.provider?.apiKeyKeychain)||'', headers:(c.provider?.headers)||{}, reasoningEffort:'low' };
writeFileSync('$CFG', JSON.stringify(c,null,2));
"
echo "   verifying key…"
if CC_TURN_EXT_HOME="$CC_HOME" node --input-type=module -e "
import {streamChat} from '$ROOT/core/provider.mjs';
let o=''; for await (const t of streamChat([{role:'user',content:'say OK'}],{reasoningEffort:'low'})) o+=t;
process.exit(o.trim()?0:1);
" 2>/dev/null; then echo "   ✓ provider responds"; else echo "   ✗ provider failed — fix key/baseUrl in $CFG, then: ccturn doctor"; fi

echo
echo "3) Policy  [1] lines(8+, no LLM)  [2] hybrid  [3] judge  [4] always"
case "$(ask 'choose (1):' 1)" in 2) POL=hybrid;; 3) POL=judge;; 4) POL=always;; *) POL=lines;; esac
echo "{\"policy\":\"$POL\",\"override\":{}}" > "$CC_HOME/state.json"

echo
echo "4) Patch + smoke test"
if bun "$ROOT/core/patcher/patch.mjs" "$REAL" "$CC_HOME/cache/claude-$(basename "$REAL").ccx" >/dev/null 2>&1; then
  chmod +x "$CC_HOME/cache/claude-$(basename "$REAL").ccx"
  shasum -a 256 "$REAL" | cut -d' ' -f1 > "$CC_HOME/cache/claude-$(basename "$REAL").srchash"
  "$CC_HOME/cache/claude-$(basename "$REAL").ccx" --version >/dev/null 2>&1 && echo "   ✓ patched binary runs" || echo "   ✗ patched binary failed to run"
else echo "   ✗ patch failed — see errors above"; fi

echo
echo "done. run:  $ROOT/bin/ccturn        (or: alias claude='$ROOT/bin/ccturn')"
echo "dashboard:  http://127.0.0.1:$(node --input-type=module -e "import {loadConfig} from '$ROOT/core/config.mjs'; process.stdout.write(String(loadConfig().port||61237))" 2>/dev/null || echo 61237)/"
