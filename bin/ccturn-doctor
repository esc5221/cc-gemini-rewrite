#!/bin/bash
# Diagnose install: claude version/arch/signature, patch status, backup, provider key, connectivity.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CC_HOME="${CC_TURN_EXT_HOME:-$HOME/.cc-turn-ext}"; CACHE="$CC_HOME/cache"
PORT="$(node --input-type=module -e "import {loadConfig} from '$ROOT/core/config.mjs'; process.stdout.write(String(loadConfig().port||61237))" 2>/dev/null | tr -dc 0-9)"
ok(){ echo "  ✓ $1"; }; bad(){ echo "  ✗ $1"; }; info(){ echo "  · $1"; }

echo "cc-turn-ext doctor (ccturn)"
echo "── claude"
if REAL="$(readlink -f "$(command -v claude)" 2>/dev/null)"; then ok "claude: $(basename "$REAL")"; else bad "claude not found in PATH"; exit 1; fi
info "arch: $(file "$REAL" | grep -o 'arm64\|x86_64' | head -1)"
codesign -v "$REAL" 2>/dev/null && ok "original signature valid" || info "original signature: (unsigned or adhoc)"

echo "── patch"
P="$CACHE/claude-$(basename "$REAL").ccx"
if [[ -f "$P" ]]; then
  ok "patched copy present"
  codesign -v "$P" 2>/dev/null && ok "patched signature valid" || bad "patched signature INVALID (run: ccturn repatch)"
  "$P" --version >/dev/null 2>&1 && ok "patched binary runs" || bad "patched binary does NOT run (run: ccturn repatch)"
  S="$CACHE/claude-$(basename "$REAL").srchash"
  [[ -f "$S" && "$(cat "$S")" == "$(shasum -a 256 "$REAL" | cut -d' ' -f1)" ]] && ok "patch up to date with current claude" || bad "claude changed — run: ccturn repatch"
else bad "no patched copy (run: ccturn  — it patches on first launch)"; fi

echo "── config"
info "home: $CC_HOME"
node --input-type=module -e "import {loadConfig} from '$ROOT/core/config.mjs'; const c=loadConfig(); console.log('  · handler:', c.handler.kind, c.handler.module||''); console.log('  · policy:', c.policy.name, '(alwaysLines='+c.policy.alwaysLines+')'); console.log('  · provider:', c.provider.baseUrl, '|', c.provider.model);" 2>/dev/null || bad "config load failed"

echo "── provider key + connectivity"
node --input-type=module -e "
import {streamChat} from '$ROOT/core/provider.mjs';
try { let o=''; for await (const t of streamChat([{role:'user',content:'say OK'}],{reasoningEffort:'low'})) o+=t; console.log('  ✓ provider responds:', JSON.stringify(o.trim().slice(0,20))); }
catch(e){ console.log('  ✗ provider FAILED:', e.message.slice(0,80)); console.log('    → check key/baseUrl in '+process.env.CC_TURN_EXT_HOME+'/config.json or run ccturn setup'); }
" 2>/dev/null

echo "── sidecar"
curl -s "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && ok "sidecar up on :$PORT" || info "sidecar down (starts on next launch). dashboard: http://127.0.0.1:$PORT/"
