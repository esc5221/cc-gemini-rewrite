#!/bin/bash
# Remove patched copies and (if present) restore any in-place backup. Never touches user config unless asked.
set -uo pipefail
CC_HOME="${CC_TURN_EXT_HOME:-$HOME/.cc-turn-ext}"; CACHE="$CC_HOME/cache"
echo "cc-turn-ext uninstall"
# restore in-place backups if any (<binary>.orig)
shopt -s nullglob
for orig in "$(dirname "$(readlink -f "$(command -v claude)")")"/*.orig; do
  [[ -f "$orig" ]] || continue; tgt="${orig%.orig}"; mv "$orig" "$tgt"; codesign -f -s - "$tgt" 2>/dev/null || true; echo "  restored $tgt"
done
shopt -u nullglob
rm -f "$CACHE"/claude-*.ccx "$CACHE"/*.srchash && echo "  removed patched copies"
PID="$(lsof -ti :$(node --input-type=module -e "import {loadConfig} from '$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/core/config.mjs'; process.stdout.write(String(loadConfig().port||61237))" 2>/dev/null || echo 61237) 2>/dev/null || true)"
[[ -n "$PID" ]] && kill "$PID" 2>/dev/null && echo "  stopped sidecar"
echo "  done. user config kept at $CC_HOME (delete manually to fully remove)."
echo "  original claude is untouched — run plain 'claude' to confirm."
